{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "baseBranchPatterns": ["develop", "main"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["github-actions"],
      "rangeStrategy": "replace"
    },
    {
      "matchBaseBranches": ["develop"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["@biomejs/biome"],
      "postUpgradeTasks": {
        "commands": [
          "pnpm dlx @biomejs/biome@{{{newVersion}}} migrate --write",
          "pnpm dlx @biomejs/biome@{{{newVersion}}} check --write"
        ],
        "fileFilters": ["**/*"],
        "executionMode": "branch"
      }
    },
    {
      "matchBaseBranches": ["main"],
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "reviewers": ["Yukigamine"]
    },
    {
      "description": "Keep ordinary updates on develop; production receives vulnerability fixes only.",
      "matchBaseBranches": ["main"],
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "lowest",
    "labels": ["security"],
    "automerge": false,
    "automergeType": "pr",
    "platformAutomerge": false,
    "reviewers": ["Yukigamine"]
  }
}
