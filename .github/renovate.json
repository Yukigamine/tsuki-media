{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "14 days",
  "baseBranchPatterns": ["develop", "main"],
  "packageRules": [
    {
      "description": "Rebase ordinary develop updates only when conflicted.",
      "matchBaseBranches": ["develop"],
      "matchJsonata": ["$not(isVulnerabilityAlert = true)"],
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": ["github-actions"],
      "rangeStrategy": "replace"
    },
    {
      "matchBaseBranches": ["develop"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Batch routine Knip and test-tool patches once a week on develop.",
      "matchBaseBranches": ["develop"],
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "knip",
        "vitest",
        "@vitest/coverage-v8",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "happy-dom"
      ],
      "matchUpdateTypes": ["patch"],
      "matchJsonata": ["$not(isVulnerabilityAlert = true)"],
      "groupName": "weekly dev-tool patches",
      "schedule": ["* 13-16 * * 1"],
      "updateNotScheduled": false
    },
    {
      "description": "Wait for Dependency Dashboard approval before opening ordinary major updates on develop.",
      "matchBaseBranches": ["develop"],
      "matchUpdateTypes": ["major"],
      "matchJsonata": ["$not(isVulnerabilityAlert = true)"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "matchPackageNames": ["@biomejs/biome"],
      "postUpgradeTasks": {
        "commands": [
          "pnpm dlx @biomejs/biome@{{{newVersion}}} migrate --write",
          "pnpm dlx @biomejs/biome@{{{newVersion}}} check --write"
        ],
        "fileFilters": ["**/*"],
        "executionMode": "branch"
      }
    },
    {
      "matchBaseBranches": ["main"],
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "reviewers": ["Yukigamine"]
    },
    {
      "description": "Keep ordinary updates on develop; production receives vulnerability fixes only.",
      "matchBaseBranches": ["main"],
      "matchPackageNames": ["*"],
      "enabled": false
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "lowest",
    "labels": ["security"],
    "automerge": false,
    "automergeType": "pr",
    "platformAutomerge": false,
    "reviewers": ["Yukigamine"]
  }
}
