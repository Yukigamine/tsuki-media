{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "14 days",
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "rangeStrategy": "replace"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "postUpgradeTasks": {
        "commands": [
          "pnpm dlx @biomejs/biome@{{{newVersion}}} migrate --write",
          "pnpm dlx @biomejs/biome@{{{newVersion}}} check --write"
        ],
        "fileFilters": [
          "**/*"
        ],
        "executionMode": "branch"
      }
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "lowest",
    "labels": [
      "security"
    ],
    "automerge": false,
    "automergeType": "pr",
    "platformAutomerge": false,
    "reviewers": [
      "Yukigamine"
    ]
  }
}
