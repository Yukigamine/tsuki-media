{
  "name": "tsuki-media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yukigamine/tsuki-media.git"
  },
  "bugs": {
    "url": "https://github.com/Yukigamine/tsuki-media/issues"
  },
  "homepage": "https://github.com/Yukigamine/tsuki-media#readme",
  "scripts": {
    "dev": "pnpm --filter @tsuki-media/anime dev",
    "dev:all": "pnpm --parallel --filter @tsuki-media/anime --filter @tsuki-media/books --filter @tsuki-media/movies dev",
    "dev:anime": "pnpm --filter @tsuki-media/anime dev",
    "dev:books": "pnpm --filter @tsuki-media/books dev",
    "dev:movies": "pnpm --filter @tsuki-media/movies dev",
    "build": "pnpm generate && pnpm --filter @tsuki-media/anime --filter @tsuki-media/books --filter @tsuki-media/movies build",
    "build:anime": "pnpm --filter @tsuki-media/anime build",
    "build:books": "pnpm --filter @tsuki-media/books build",
    "build:movies": "pnpm --filter @tsuki-media/movies build",
    "generate": "pnpm --filter @tsuki-media/anime --filter @tsuki-media/books --filter @tsuki-media/movies generate",
    "start": "pnpm --filter @tsuki-media/anime start",
    "lint": "biome lint --write",
    "lint-check": "biome check && pnpm --filter @tsuki-media/anime knip",
    "lint-staged": "lint-staged",
    "format": "biome format --write",
    "check": "biome check --write",
    "knip": "pnpm --filter @tsuki-media/anime knip",
    "knip:deps": "pnpm --filter @tsuki-media/anime exec knip --dependencies",
    "test": "vitest run",
    "typecheck": "pnpm --filter @tsuki-media/books --filter @tsuki-media/movies --filter @tsuki-media/providers --filter @tsuki-media/ui typecheck",
    "prepare": "pnpm --filter @tsuki-media/anime generate && husky",
    "deploy": "pnpm --filter @tsuki-media/anime deploy",
    "deploy:anime": "pnpm --filter @tsuki-media/anime deploy",
    "deploy:books": "pnpm --filter @tsuki-media/books deploy",
    "deploy:movies": "pnpm --filter @tsuki-media/movies deploy",
    "db-edit": "pnpm --filter @tsuki-media/anime db-edit",
    "db-init": "pnpm --filter @tsuki-media/anime db-init",
    "zeus:kitsu": "pnpm --filter @tsuki-media/anime zeus:kitsu",
    "zeus:anilist": "pnpm --filter @tsuki-media/anime zeus:anilist",
    "branding:generate": "node scripts/generate-branding.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "happy-dom": "20.14.6",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@12.13.0"
}
